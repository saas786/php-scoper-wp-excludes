{
	"name": "saas786/php-scoper-wp-excludes",
	"description": "Custom function and class declaration stubs for static analysis.",
	"license": "GPL-2.0-or-later",
	"type": "library",
	"homepage": "https://github.com/saas786/php-scoper-wp-excludes",
	"require-dev": {
		"php": ">=8.2",
		"composer/installers": "^1.12 || ^2.0",
		"php-stubs/generator": "^0.8.5",
		"sniccowp/php-scoper-excludes": "dev-master",
		"symfony/console": "^5.1 || ^6.0 || ^7.0"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/GravityPDF/php-scoper-excludes"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"platform": {
			"php": "8.2"
		},
		"process-timeout": 0
	}
}
